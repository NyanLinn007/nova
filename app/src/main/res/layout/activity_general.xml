<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#252F40"
    tools:context=".view.General">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnclose"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="Close icon"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:gravity="end|center_vertical"
                android:text="Topics"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Explore Title -->
        <TextView
            android:id="@+id/txtExploreTopics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore topics"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            android:layout_marginTop="20dp" />

        <!-- Search View (wrapped in a LinearLayout to apply equal width) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="15dp">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/SearchView"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/search_bg"
                app:queryHint="Search Topics"
                app:iconifiedByDefault="false" />
        </LinearLayout>



        <LinearLayout
            android:id="@+id/itemRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- First Item -->

            <!-- Second Item -->
            <RelativeLayout
                android:id="@+id/my_favorite"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/item_bg">

                <TextView
                    android:id="@+id/text_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Favorite"
                    android:gravity="start"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="8dp" />

                <ImageView
                    android:id="@+id/image_favorite"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_favourite" />

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/general"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/item_bg">

                <TextView
                    android:id="@+id/owmcode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General"
                    android:gravity="start"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="8dp" />

                <ImageView
                    android:id="@+id/imgown"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_favourite" />

            </RelativeLayout>

        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <!-- Themes Label -->
            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Most Popular"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Themes RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvgeneral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:layout_marginTop="10dp"
                tools:listitem="@layout/mostpopular_list"
                tools:itemCount="4"
                app:layout_constraintTop_toBottomOf="@id/textView9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/foryou"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For you"
                android:layout_marginTop="10dp"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/textView9"
                app:layout_constraintTop_toBottomOf="@+id/rvgeneral" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvforyou"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                tools:listitem="@layout/generalforyou_list"
                tools:itemCount="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/foryou" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</ScrollView>
